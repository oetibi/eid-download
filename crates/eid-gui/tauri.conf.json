{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eid Download",
  "version": "0.1.0",
  "identifier": "com.eid.download",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "Eid Download",
    "copyright": "MIT License",
    "shortDescription": "Eid Download - download manager",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Eid Download",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eid Download",
  "version": "0.0.1",
  "identifier": "com.eid.download",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
